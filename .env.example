DATABASE_URL=postgresql://noxyn:noxyn-local-only@127.0.0.1:55432/noxyn_solari
NOXYN_API_URL=http://127.0.0.1:8000
NOXYN_WORKER_HEARTBEAT_SECONDS=10
NOXYN_WORKER_POLL_SECONDS=1
NOXYN_WORKER_LEASE_SECONDS=30
NOXYN_ARTIFACT_ROOT=.artifacts/noxyn

# Clerk development keys belong in apps/console/.env.local. See
# apps/console/.env.example. Never enable this bypass in production.
NOXYN_E2E_AUTH_BYPASS=false

# Worker-only. Live Solari execution remains opt-in.
NOXYN_EXECUTOR_MODE=replay
SOLARI_API_BASE_URL=https://api.getsolari.com
SOLARI_API_KEY=
