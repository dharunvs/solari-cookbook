    "eslint": "9.39.1",
    "globals": "16.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.1.0"
  }
}
